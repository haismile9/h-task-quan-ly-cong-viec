# Sao chép thành deploy/.env trên server rồi điền giá trị. KHÔNG commit file .env.

# Cổng backend nghe trên localhost của server (Nginx proxy vào cổng này)
BACKEND_PORT=8081

# Laravel
APP_NAME=H-Task
APP_ENV=production
APP_DEBUG=false
# Tạo bằng: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_URL=https://htask-api.haismile.dev
FRONTEND_URL=https://ten-project.vercel.app
APP_TIMEZONE=UTC

# Database (container mysql tự tạo database và user theo các giá trị này)
DB_DATABASE=htask
DB_USERNAME=htask
DB_PASSWORD=doi_mat_khau_manh

# Email (Gmail: dùng App Password)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="H-Task"

# Lưu cache/session/hàng đợi trong database
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=sync
